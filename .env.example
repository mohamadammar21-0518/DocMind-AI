GROQ_API_KEY=gsk_your_groq_api_key_here

# Persistent ChromaDB storage directory (default: /data/chroma_db on Cloud Run)
CHROMA_PERSIST_DIR=/data/chroma_db

# SQLAlchemy database URL — SQLite for local dev, PostgreSQL for production
# Examples:
#   sqlite:///./sessions.db
#   postgresql://user:password@host:5432/docmind
DATABASE_URL=sqlite:///./sessions.db

# Secret key for the GET /admin/query-logs endpoint (set a strong random value)
ADMIN_API_KEY=changeme
